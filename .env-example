# Calendar Sync Environment Variables
# Copy this file to .env and fill in your actual values

# Google Calendar Configuration
GOOGLE_CALENDAR_ID=primary
# Your Google Calendar ID (usually 'primary' for main calendar)

# iCloud Calendar Configuration
ICLOUD_USERNAME=your_icloud_email@example.com
ICLOUD_PASSWORD=your_app_specific_password
# Note: Use an App-Specific Password, not your regular iCloud password
# Generate one at: https://appleid.apple.com/account/manage

# Sync Configuration
SYNC_DIRECTION=two_way
# Options: 'google_to_icloud', 'icloud_to_google', 'two_way'

# Time Window Configuration
WINDOW_PAST_DAYS=90
WINDOW_FUTURE_DAYS=365
# Number of days to look back/forward for events

# Debug/Testing
DRY_RUN=false
# Set to 'true' to preview changes without making them

# Optional: Custom Calendar Names
# GOOGLE_CALENDAR_NAME=My Google Calendar
# ICLOUD_CALENDAR_NAME=My iCloud Calendar
